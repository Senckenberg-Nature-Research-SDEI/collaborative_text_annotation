@prefix ex: <https://example.org/cq/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://example.org/cq/story/butterfly-researcher> a ex:UserStory ;
  rdfs:label "Butterfly Researcher" .

<https://example.org/cq/cq/butterfly-researcher/cq1> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ1" ;
  rdfs:label "Taxonomic Synonymy" ;
  ex:questionText "Which subjective junior synonyms have been reported for a given species within a specified geographic region?" ;
  ex:inUserStory <https://example.org/cq/story/butterfly-researcher> .

<https://example.org/cq/concept/butterfly-researcher/cq1/species> a ex:Concept ;
  rdfs:label "Species" ;
  dcterms:description "A group of organisms capable of interbreeding and producing fertile offspring" ;
  skos:altLabel "Taxon" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq1> .

<https://example.org/cq/concept/butterfly-researcher/cq1/subjective-junior-synonym> a ex:Concept ;
  rdfs:label "Subjective junior synonym" ;
  dcterms:description "A later name considered to refer to the same taxon as an earlier name based on taxonomic opinion" ;
  skos:altLabel "Junior synonym" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq1> .

<https://example.org/cq/concept/butterfly-researcher/cq1/geographic-region> a ex:Concept ;
  rdfs:label "Geographic region" ;
  dcterms:description "A defined area or location on Earth" ;
  skos:altLabel "Region" ;
  skos:altLabel "Location" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq1> .

<https://example.org/cq/property/butterfly-researcher/cq1/has-subjective-junior-synonym> a rdf:Property, ex:ExtractedProperty ;
  rdfs:label "has subjective junior synonym" ;
  dcterms:description "Relates a species to its subjective junior synonyms" ;
  rdfs:domain <https://example.org/cq/concept/butterfly-researcher/cq1/species> ;
  rdfs:range <https://example.org/cq/concept/butterfly-researcher/cq1/subjective-junior-synonym> ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq1> .

<https://example.org/cq/property/butterfly-researcher/cq1/reported-in> a rdf:Property, ex:ExtractedProperty ;
  rdfs:label "reported in" ;
  dcterms:description "Indicates the geographic region where the subjective junior synonym has been reported" ;
  rdfs:domain <https://example.org/cq/concept/butterfly-researcher/cq1/subjective-junior-synonym> ;
  rdfs:range <https://example.org/cq/concept/butterfly-researcher/cq1/geographic-region> ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq1> .

<https://example.org/cq/cq/butterfly-researcher/cq2> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ2" ;
  rdfs:label "Type Specimen Repository" ;
  ex:questionText "In which collection or institution is the type specimen of a given species deposited?" ;
  ex:inUserStory <https://example.org/cq/story/butterfly-researcher> .

<https://example.org/cq/concept/butterfly-researcher/cq2/type-specimen> a ex:Concept ;
  rdfs:label "Type Specimen" ;
  dcterms:description "A specimen used to define the species" ;
  skos:altLabel "Holotype" ;
  skos:altLabel "Reference Specimen" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq2> .

<https://example.org/cq/concept/butterfly-researcher/cq2/species> a ex:Concept ;
  rdfs:label "Species" ;
  dcterms:description "A group of organisms capable of interbreeding" ;
  skos:altLabel "Taxon" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq2> .

<https://example.org/cq/concept/butterfly-researcher/cq2/collection> a ex:Concept ;
  rdfs:label "Collection" ;
  dcterms:description "An organized set of specimens held for study" ;
  skos:altLabel "Specimen Collection" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq2> .

<https://example.org/cq/concept/butterfly-researcher/cq2/institution> a ex:Concept ;
  rdfs:label "Institution" ;
  dcterms:description "An organization housing collections" ;
  skos:altLabel "Museum" ;
  skos:altLabel "Repository" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq2> .

<https://example.org/cq/property/butterfly-researcher/cq2/is-deposited-in> a rdf:Property, ex:ExtractedProperty ;
  rdfs:label "is deposited in" ;
  dcterms:description "Indicates the collection where the type specimen is held" ;
  rdfs:domain <https://example.org/cq/concept/butterfly-researcher/cq2/type-specimen> ;
  rdfs:range <https://example.org/cq/concept/butterfly-researcher/cq2/collection> ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq2> .

<https://example.org/cq/property/butterfly-researcher/cq2/is-held-by> a rdf:Property, ex:ExtractedProperty ;
  rdfs:label "is held by" ;
  dcterms:description "Indicates the institution responsible for the collection" ;
  rdfs:domain <https://example.org/cq/concept/butterfly-researcher/cq2/collection> ;
  rdfs:range <https://example.org/cq/concept/butterfly-researcher/cq2/institution> ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq2> .

<https://example.org/cq/property/butterfly-researcher/cq2/has-type-specimen> a rdf:Property, ex:ExtractedProperty ;
  rdfs:label "has type specimen" ;
  dcterms:description "Links a species to its defining type specimen" ;
  rdfs:domain <https://example.org/cq/concept/butterfly-researcher/cq2/species> ;
  rdfs:range <https://example.org/cq/concept/butterfly-researcher/cq2/type-specimen> ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq2> .

<https://example.org/cq/cq/butterfly-researcher/cq3> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ3" ;
  rdfs:label "Associated Digital Resources" ;
  ex:questionText "What photographs, DNA barcodes, or other digital resources are available for a given type specimen?" ;
  ex:inUserStory <https://example.org/cq/story/butterfly-researcher> .

<https://example.org/cq/concept/butterfly-researcher/cq3/type-specimen> a ex:Concept ;
  rdfs:label "Type specimen" ;
  dcterms:description "A specimen designated as the reference for a species" ;
  skos:altLabel "Specimen" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq3> .

<https://example.org/cq/concept/butterfly-researcher/cq3/photograph> a ex:Concept ;
  rdfs:label "Photograph" ;
  dcterms:description "A digital image capturing the visual appearance of a specimen" ;
  skos:altLabel "Image" ;
  skos:altLabel "Photo" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq3> .

<https://example.org/cq/concept/butterfly-researcher/cq3/dna-barcode> a ex:Concept ;
  rdfs:label "DNA barcode" ;
  dcterms:description "A short genetic sequence from a standardized region of the genome used for species identification" ;
  skos:altLabel "Genetic barcode" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq3> .

<https://example.org/cq/concept/butterfly-researcher/cq3/digital-resource> a ex:Concept ;
  rdfs:label "Digital resource" ;
  dcterms:description "Any digital data or media related to a specimen" ;
  skos:altLabel "Digital data" ;
  skos:altLabel "Digital media" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq3> .

<https://example.org/cq/property/butterfly-researcher/cq3/has-digital-resource> a rdf:Property, ex:ExtractedProperty ;
  rdfs:label "has digital resource" ;
  dcterms:description "Associates a type specimen with digital resources available for it" ;
  rdfs:domain <https://example.org/cq/concept/butterfly-researcher/cq3/type-specimen> ;
  rdfs:range <https://example.org/cq/concept/butterfly-researcher/cq3/digital-resource> ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq3> .

<https://example.org/cq/property/butterfly-researcher/cq3/is-photograph-of> a rdf:Property, ex:ExtractedProperty ;
  rdfs:label "is photograph of" ;
  dcterms:description "Indicates the specimen that is depicted in the photograph" ;
  rdfs:domain <https://example.org/cq/concept/butterfly-researcher/cq3/photograph> ;
  rdfs:range <https://example.org/cq/concept/butterfly-researcher/cq3/type-specimen> ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq3> .

<https://example.org/cq/property/butterfly-researcher/cq3/is-dna-barcode-of> a rdf:Property, ex:ExtractedProperty ;
  rdfs:label "is DNA barcode of" ;
  dcterms:description "Indicates the specimen from which the DNA barcode was obtained" ;
  rdfs:domain <https://example.org/cq/concept/butterfly-researcher/cq3/dna-barcode> ;
  rdfs:range <https://example.org/cq/concept/butterfly-researcher/cq3/type-specimen> ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq3> .

<https://example.org/cq/cq/butterfly-researcher/cq4> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ4" ;
  rdfs:label "Temporal Trends in Species Descriptions" ;
