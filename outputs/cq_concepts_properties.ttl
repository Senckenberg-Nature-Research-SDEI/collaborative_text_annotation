  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq5> .

<https://example.org/cq/property/butterfly-researcher/cq5/collectedat> a rdf:Property, ex:ExtractedProperty ;
  rdfs:label "collectedAt" ;
  dcterms:description "Indicates the location where the type specimen was originally collected" ;
