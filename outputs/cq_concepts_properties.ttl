  ex:inUserStory <https://example.org/cq/story/butterfly-researcher> .

<https://example.org/cq/concept/butterfly-researcher/cq4/species-description> a ex:Concept ;
  rdfs:label "Species Description" ;
  dcterms:description "A formal account or characterization of a species" ;
