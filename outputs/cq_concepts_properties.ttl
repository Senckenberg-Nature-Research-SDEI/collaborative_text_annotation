<https://example.org/cq/concept/location> a owl:Class, ex:Concept ;
  rdfs:label "Location" ;
  owl:equivalentClass <http://rs.tdwg.org/dwc/dwctype/Location> ;
  skos:exactMatch <http://rs.tdwg.org/dwc/dwctype/Location> ;
  ex:matchedTermIRI "http://rs.tdwg.org/dwc/dwctype/Location" ;
  ex:matchedTermLabel "Location" ;
  ex:matchedTermLocalName "Location" ;
  ex:matchedTermType "http://www.w3.org/2000/01/rdf-schema#Class" ;
  ex:termMatchScore "71.05" ;
