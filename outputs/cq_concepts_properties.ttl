  skos:altLabel "Species Identification" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq4> .

<https://example.org/cq/concept/butterfly-researcher/cq4/year> a ex:Concept ;
  rdfs:label "Year" ;
  dcterms:description "A calendar year representing a point in time" ;
  skos:altLabel "Calendar Year" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq4> .

<https://example.org/cq/concept/butterfly-researcher/cq4/taxonomic-group> a ex:Concept ;
  rdfs:label "Taxonomic Group" ;
