  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq4> .

<https://example.org/cq/property/butterfly-researcher/cq4/hascount> a rdf:Property, ex:ExtractedProperty ;
  rdfs:label "hasCount" ;
