  skos:altLabel "Taxa" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq4> .

<https://example.org/cq/concept/butterfly-researcher/cq4/trend> a ex:Concept ;
  rdfs:label "Trend" ;
  dcterms:description "A general direction or pattern of change over time" ;
  skos:altLabel "Pattern" ;
  skos:altLabel "Temporal Trend" ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq4> .

<https://example.org/cq/property/butterfly-researcher/cq4/hasdescriptionyear> a rdf:Property, ex:ExtractedProperty ;
  rdfs:label "hasDescriptionYear" ;
  dcterms:description "The year in which the species description was published" ;
  rdfs:domain <https://example.org/cq/concept/butterfly-researcher/cq4/species-description> ;
  rdfs:range <https://example.org/cq/concept/butterfly-researcher/cq4/year> ;
  ex:extractedFrom <https://example.org/cq/cq/butterfly-researcher/cq4> .

<https://example.org/cq/property/butterfly-researcher/cq4/belongstotaxonomicgroup> a rdf:Property, ex:ExtractedProperty ;
  rdfs:label "belongsToTaxonomicGroup" ;
