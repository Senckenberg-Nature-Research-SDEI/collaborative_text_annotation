  skos:definition "A place or area where an event or occurrence happens, such as a geographic region" ;
  rdfs:comment "A place or area where an event or occurrence happens, such as a geographic region" ;
  dcterms:description "A place or area where an Event occurs" ;
  skos:definition "A place or area where an Event occurs" ;
