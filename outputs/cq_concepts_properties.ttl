@prefix ex: <https://example.org/cq/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://example.org/cq/story/butterfly-researcher> a ex:UserStory ;
  rdfs:label "Butterfly Researcher" .

<https://example.org/cq/cq/butterfly-researcher/cq1> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ1" ;
  rdfs:label "Taxonomic Synonymy" ;
  ex:questionText "Which subjective junior synonyms have been reported for a given species within a specified geographic region?" ;
  ex:inUserStory <https://example.org/cq/story/butterfly-researcher> .

<https://example.org/cq/cq/butterfly-researcher/cq2> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ2" ;
  rdfs:label "Type Specimen Repository" ;
  ex:questionText "In which collection or institution is the type specimen of a given species deposited?" ;
  ex:inUserStory <https://example.org/cq/story/butterfly-researcher> .

<https://example.org/cq/cq/butterfly-researcher/cq3> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ3" ;
  rdfs:label "Associated Digital Resources" ;
  ex:questionText "What photographs, DNA barcodes, or other digital resources are available for a given type specimen?" ;
  ex:inUserStory <https://example.org/cq/story/butterfly-researcher> .

<https://example.org/cq/cq/butterfly-researcher/cq4> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ4" ;
  rdfs:label "Temporal Trends in Species Descriptions" ;
  ex:questionText "How has the number of species descriptions changed over time, and what trends can be observed across different years or taxonomic groups?" ;
  ex:inUserStory <https://example.org/cq/story/butterfly-researcher> .

<https://example.org/cq/cq/butterfly-researcher/cq5> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ5" ;
  rdfs:label "Type Locality Information" ;
  ex:questionText "Where was the type specimen of a given species originally collected?" ;
  ex:inUserStory <https://example.org/cq/story/butterfly-researcher> .

<https://example.org/cq/cq/butterfly-researcher/cq6> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ6" ;
  rdfs:label "Geographic Distribution of Type Specimens" ;
  ex:questionText "Which type specimens originate from a specified geographic region or island group?" ;
  ex:inUserStory <https://example.org/cq/story/butterfly-researcher> .

<https://example.org/cq/cq/butterfly-researcher/cq7> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ7" ;
  rdfs:label "Taxonomic Authorship" ;
  ex:questionText "Who described a given species, and in which publication was it originally described?" ;
  ex:inUserStory <https://example.org/cq/story/butterfly-researcher> .

<https://example.org/cq/cq/butterfly-researcher/cq8> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ8" ;
  rdfs:label "Collection Holdings" ;
  ex:questionText "Which type specimens are held by a particular museum, institution, or collection?" ;
  ex:inUserStory <https://example.org/cq/story/butterfly-researcher> .

<https://example.org/cq/story/chief-editor-of-a-zoological-journal> a ex:UserStory ;
  rdfs:label "Chief Editor of a Zoological Journal" .

<https://example.org/cq/cq/chief-editor-of-a-zoological-journal/cq1> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ1" ;
  rdfs:label "Published Type Specimens and Metadata" ;
  ex:questionText "Which type specimens are published or mentioned in the journal, and what associated metadata are available (e.g., hosting institution, institutional codes, specimen identifiers/PIDs, taxonomic information, locality, sex, and number of specimens)?" ;
  ex:inUserStory <https://example.org/cq/story/chief-editor-of-a-zoological-journal> .

<https://example.org/cq/cq/chief-editor-of-a-zoological-journal/cq2> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ2" ;
  rdfs:label "Type Specimen Quantification" ;
  ex:questionText "How many type specimens are represented in the journal?" ;
  ex:inUserStory <https://example.org/cq/story/chief-editor-of-a-zoological-journal> .

<https://example.org/cq/cq/chief-editor-of-a-zoological-journal/cq3> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ3" ;
  rdfs:label "Collection and Repository Holdings" ;
  ex:questionText "Which institutions and collections currently hold the type specimens published in the journal?" ;
  ex:inUserStory <https://example.org/cq/story/chief-editor-of-a-zoological-journal> .

<https://example.org/cq/cq/chief-editor-of-a-zoological-journal/cq4> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ4" ;
  rdfs:label "Taxonomic Distribution" ;
  ex:questionText "How are the type specimens published in the journal distributed across taxonomic groups (e.g., family, genus, species)?" ;
  ex:inUserStory <https://example.org/cq/story/chief-editor-of-a-zoological-journal> .

<https://example.org/cq/cq/chief-editor-of-a-zoological-journal/cq5> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ5" ;
  rdfs:label "Geographic Distribution" ;
  ex:questionText "How are the type specimens published in the journal distributed geographically according to collection localities or gathering sites?" ;
  ex:inUserStory <https://example.org/cq/story/chief-editor-of-a-zoological-journal> .

<https://example.org/cq/cq/chief-editor-of-a-zoological-journal/cq6> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ6" ;
  rdfs:label "Relevant Publications and Catalogues" ;
  ex:questionText "Which publications in the journal contain type specimen information, and which publications can be identified as type specimen catalogues?" ;
  ex:inUserStory <https://example.org/cq/story/chief-editor-of-a-zoological-journal> .

<https://example.org/cq/cq/chief-editor-of-a-zoological-journal/cq7> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ7" ;
  rdfs:label "Publication Context" ;
  ex:questionText "In which publications and publication sections is information on a specific type specimen reported?" ;
  ex:inUserStory <https://example.org/cq/story/chief-editor-of-a-zoological-journal> .

<https://example.org/cq/cq/chief-editor-of-a-zoological-journal/cq8> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ8" ;
  rdfs:label "Major Contributors" ;
  ex:questionText "Which publications contribute the largest number of type specimen records to the journal?" ;
  ex:inUserStory <https://example.org/cq/story/chief-editor-of-a-zoological-journal> .

<https://example.org/cq/cq/chief-editor-of-a-zoological-journal/cq9> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ9" ;
  rdfs:label "Temporal Trends" ;
  ex:questionText "How has the publication of type specimen information changed over time within the journal?" ;
  ex:inUserStory <https://example.org/cq/story/chief-editor-of-a-zoological-journal> .

<https://example.org/cq/story/collection-manager> a ex:UserStory ;
  rdfs:label "Collection Manager" .

<https://example.org/cq/cq/collection-manager/cq1> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ1" ;
  rdfs:label "Type Specimen Documentation" ;
  ex:questionText "Which type specimens are documented in the available type specimen catalogues and publications, and what information is available for them?" ;
  ex:inUserStory <https://example.org/cq/story/collection-manager> .

<https://example.org/cq/cq/collection-manager/cq2> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ2" ;
  rdfs:label "Available Catalogues and Publications" ;
  ex:questionText "Which type specimen catalogues and publications are available for my institution or collection?" ;
  ex:inUserStory <https://example.org/cq/story/collection-manager> .

<https://example.org/cq/cq/collection-manager/cq3> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ3" ;
  rdfs:label "Specialist Contributions" ;
  ex:questionText "Which authors or specialists have documented type specimens from my collection?" ;
  ex:inUserStory <https://example.org/cq/story/collection-manager> .

<https://example.org/cq/cq/collection-manager/cq4> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ4" ;
  rdfs:label "Relevant Publications" ;
  ex:questionText "Which publications provide information about a particular type specimen or group of type specimens?" ;
  ex:inUserStory <https://example.org/cq/story/collection-manager> .

<https://example.org/cq/cq/collection-manager/cq5> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ5" ;
  rdfs:label "Metadata Availability" ;
  ex:questionText "Which metadata elements (e.g., taxonomy, locality, collector, identifiers, repository information, references, images) are documented for type specimens in the available catalogues and publications?" ;
  ex:inUserStory <https://example.org/cq/story/collection-manager> .

<https://example.org/cq/cq/collection-manager/cq6> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ6" ;
  rdfs:label "Documentation Completeness" ;
  ex:questionText "Which type specimens have the most comprehensive documentation across catalogues and publications?" ;
  ex:inUserStory <https://example.org/cq/story/collection-manager> .

<https://example.org/cq/cq/collection-manager/cq7> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ7" ;
  rdfs:label "Catalogue Coverage" ;
  ex:questionText "Which type specimen catalogues provide the most comprehensive documentation for a collection, taxonomic group, or set of type specimens?" ;
  ex:inUserStory <https://example.org/cq/story/collection-manager> .

<https://example.org/cq/cq/collection-manager/cq8> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ8" ;
  rdfs:label "Multiple Documentation Sources" ;
  ex:questionText "Which type specimens are documented by multiple catalogues or publications?" ;
  ex:inUserStory <https://example.org/cq/story/collection-manager> .

<https://example.org/cq/cq/collection-manager/cq9> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ9" ;
  rdfs:label "Historical Changes in Documentation" ;
  ex:questionText "How has the information available for a particular type specimen changed across catalogues and publications over time?" ;
  ex:inUserStory <https://example.org/cq/story/collection-manager> .

<https://example.org/cq/cq/collection-manager/cq10> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ10" ;
  rdfs:label "Identifiers and External Resources" ;
  ex:questionText "Which type specimens have associated identifiers, collection numbers, or links to external resources?" ;
  ex:inUserStory <https://example.org/cq/story/collection-manager> .

<https://example.org/cq/cq/collection-manager/cq11> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ11" ;
  rdfs:label "Richly Connected Specimens" ;
  ex:questionText "Which type specimens are associated with the richest network of linked information, such as publications, taxonomic names, institutions, collectors, localities, and identifiers?" ;
  ex:inUserStory <https://example.org/cq/story/collection-manager> .

<https://example.org/cq/cq/collection-manager/cq12> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ12" ;
  rdfs:label "Information Diversity and Coverage" ;
  ex:questionText "How does the amount and diversity of information available for type specimens vary across catalogues and publications?" ;
  ex:inUserStory <https://example.org/cq/story/collection-manager> .

<https://example.org/cq/story/scientific-head-of-collection> a ex:UserStory ;
  rdfs:label "Scientific Head of Collection" .

<https://example.org/cq/cq/scientific-head-of-collection/cq1> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ1" ;
  rdfs:label "Type Specimen Inventory" ;
  ex:questionText "Which type specimens are documented in the collection?" ;
  ex:inUserStory <https://example.org/cq/story/scientific-head-of-collection> .

<https://example.org/cq/cq/scientific-head-of-collection/cq2> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ2" ;
  rdfs:label "Type Specimen Quantification" ;
  ex:questionText "How many type specimens exist in the collection?" ;
  ex:inUserStory <https://example.org/cq/story/scientific-head-of-collection> .

<https://example.org/cq/cq/scientific-head-of-collection/cq3> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ3" ;
  rdfs:label "Taxonomic Distribution" ;
  ex:questionText "How are type specimens distributed across taxonomic groups?" ;
  ex:inUserStory <https://example.org/cq/story/scientific-head-of-collection> .

<https://example.org/cq/cq/scientific-head-of-collection/cq4> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ4" ;
  rdfs:label "Collection Strengths by Taxon" ;
  ex:questionText "Which taxonomic groups are best represented in the collection?" ;
  ex:inUserStory <https://example.org/cq/story/scientific-head-of-collection> .

<https://example.org/cq/cq/scientific-head-of-collection/cq5> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ5" ;
  rdfs:label "Geographic Coverage" ;
  ex:questionText "What geographic regions are represented by the collection's type specimens?" ;
  ex:inUserStory <https://example.org/cq/story/scientific-head-of-collection> .

<https://example.org/cq/cq/scientific-head-of-collection/cq6> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ6" ;
  rdfs:label "Published Catalogues" ;
  ex:questionText "Which catalogues documenting the collection have been published?" ;
  ex:inUserStory <https://example.org/cq/story/scientific-head-of-collection> .

<https://example.org/cq/cq/scientific-head-of-collection/cq7> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ7" ;
  rdfs:label "Specialist Contributions" ;
  ex:questionText "Which specialists have documented or studied the collection's type specimens?" ;
  ex:inUserStory <https://example.org/cq/story/scientific-head-of-collection> .

<https://example.org/cq/cq/scientific-head-of-collection/cq8> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ8" ;
  rdfs:label "Historical Interpretation" ;
  ex:questionText "How has the scientific interpretation of the collection changed over time?" ;
  ex:inUserStory <https://example.org/cq/story/scientific-head-of-collection> .

<https://example.org/cq/cq/scientific-head-of-collection/cq9> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ9" ;
  rdfs:label "Collection Development" ;
  ex:questionText "How has the collection developed throughout its history?" ;
  ex:inUserStory <https://example.org/cq/story/scientific-head-of-collection> .

<https://example.org/cq/cq/scientific-head-of-collection/cq10> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ10" ;
  rdfs:label "Collection Strength Assessment" ;
  ex:questionText "What are the principal scientific strengths of the collection?" ;
  ex:inUserStory <https://example.org/cq/story/scientific-head-of-collection> .

<https://example.org/cq/cq/scientific-head-of-collection/cq11> a ex:CompetencyQuestion ;
  dcterms:identifier "CQ11" ;
  rdfs:label "Knowledge Contribution of Catalogues" ;
  ex:questionText "Which catalogues contribute the most knowledge and documentation about the collection?" ;
  ex:inUserStory <https://example.org/cq/story/scientific-head-of-collection> .

